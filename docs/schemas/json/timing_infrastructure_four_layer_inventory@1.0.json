{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timing_infrastructure_four_layer_inventory@1.0",
  "title": "FactorLab timing infrastructure four-layer inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "updated_at",
    "production_authority",
    "execution_order",
    "owner_lanes",
    "shared_frozen",
    "allowlist_intersection_exceptions",
    "split_required",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "timing_infrastructure_four_layer_inventory@1.0"},
    "status": {"const": "step_a_frozen_waiting_lane_execution"},
    "updated_at": {"type": "string"},
    "production_authority": {"const": false},
    "execution_order": {
      "type": "array",
      "const": ["clock", "measurement", "strategy_foundation", "strategy_ephemeral", "execution"]
    },
    "owner_lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3"],
      "properties": {
        "1": {"const": "clock"},
        "2": {"const": "measurement_and_strategy"},
        "3": {"const": "execution"}
      }
    },
    "shared_frozen": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "allowlist_intersection_exceptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "allowed_lanes", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "allowed_lanes": {
            "type": "array",
            "items": {"type": "integer", "enum": [1, 2, 3]}
          },
          "reason": {"type": "string"}
        }
      }
    },
    "split_required": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["from", "into"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "into": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string"}
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "layer",
        "owner_lane",
        "split_from",
        "reusable",
        "current",
        "live_entry",
        "code",
        "tests",
        "workflow",
        "whitepaper",
        "write_allowlist",
        "write_denylist",
        "measurement_authority",
        "routing_authority",
        "production_authority"
      ],
      "additionalProperties": false,
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "layer": {
          "type": "string",
          "enum": ["clock", "measurement", "strategy_foundation", "strategy_ephemeral", "execution"]
        },
        "owner_lane": {"type": "integer", "enum": [1, 2, 3]},
        "split_from": {"type": ["string", "null"]},
        "reusable": {"type": "boolean"},
        "current": {"type": "boolean"},
        "live_entry": {"type": ["string", "null"]},
        "code": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "workflow": {"type": ["string", "null"]},
        "whitepaper": {"type": ["string", "null"]},
        "write_allowlist": {"type": "array", "items": {"type": "string"}},
        "write_denylist": {"type": "array", "items": {"type": "string"}},
        "measurement_authority": {"type": "boolean"},
        "routing_authority": {"type": "boolean"},
        "production_authority": {"const": false},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "measurement_authority": {"const": true},
              "routing_authority": {"const": true}
            },
            "required": ["measurement_authority", "routing_authority"]
          }
        }
      ]
    }
  }
}

{
  "schema_id": "factorlab_broad_rmr_next_data_admission_and_R1_retest@2.0",
  "session_date": "2026-09-08",
  "program_identity": "broad_reversal_mean_reversion_discovery_program_v1",
  "status": "frozen_prospectively_under_reusable_train_validation_blackbox_policy",
  "data_role_policy": "docs/governance/reversal_mean_reversion_data_reuse_validation_policy_v1.md",
  "purpose": "admit_new_data_without_treating_historical_data_as_single_use_and_without_losing_a_small_independent_confirmation_reserve",
  "phase_1_source_admission": {
    "required_before_strategy_use": true,
    "checks": [
      "exact_dataset_identity_version_and_content_hash_or_equivalent_content_address",
      "instrument_and_date_coverage",
      "raw_frequency_and_derivation_lineage",
      "timestamp_bar_start_end_or_observation_semantics",
      "timezone_and_session_wall_clock_semantics",
      "trading_calendar_identity",
      "duplicate_timestamp_ledger",
      "missing_required_clock_ledger",
      "unexpected_clock_ledger",
      "repair_or_imputation_ledger",
      "explicit_confirmation_that_synthetic_OHLC_fill_is_not_silent",
      "availability_or_point_in_time_semantics_where_relevant"
    ],
    "failure_policy": "fail_closed_for_affected_dataset_not_for_entire_research_program"
  },
  "phase_2_measurement_classification": {
    "required_for_path_features": true,
    "allowed_classes": [
      "admitted_actual_finer_source_direct_measurement",
      "fully_enveloped_finite_interval_measurement_under_v0617",
      "structural_gap_partial_identification_interval_under_v0617"
    ],
    "native_5m_OHLC_as_exact_fine_path": false,
    "interval_midpoint_as_truth": false,
    "structural_gap_drop_filter": false
  },
  "phase_3_reusable_evidence_roles": {
    "historical_2015_2018": "TRAIN_research_corpus_reusable",
    "historical_2019_2020": "VALIDATION_diagnostic_reusable",
    "historical_data_expired_after_use": false,
    "TRAIN_may_be_reused_for": [
      "feature_development",
      "model_training",
      "mechanism_design",
      "parameter_estimation",
      "event_level_diagnostics",
      "error_analysis"
    ],
    "VALIDATION_may_be_reused_for": [
      "chronological_validation",
      "detailed_failure_diagnostics",
      "year_and_regime_breakdowns",
      "subsequent_model_revision"
    ],
    "new_data_default_assignment": [
      "after_source_admission_add_most_new_history_to_TRAIN_or_VALIDATION_as_needed",
      "reserve_only_a_small_latest_sufficient_contiguous_block_as_BLACKBOX_after_candidate_maturity",
      "do_not_allocate_blackbox_for_every_early_hypothesis",
      "freeze_exact_blackbox_dates_only_when_a_candidate_is_ready_for_confirmation"
    ]
  },
  "blackbox_confirmation_policy": {
    "role": "independent_final_confirmation_not_general_development",
    "default_outputs": [
      "sample_count",
      "predeclared_primary_metric",
      "predeclared_benchmark_comparison",
      "pass_fail_or_insufficient",
      "data_integrity_gate"
    ],
    "default_forbidden_outputs": [
      "event_dates",
      "event_paths",
      "year_breakdowns",
      "direction_breakdowns",
      "regime_breakdowns",
      "failure_cases",
      "parameter_sensitivity",
      "diagnostic_information_that_can_target_strategy_repair"
    ],
    "if_detailed_diagnostics_requested_after_failure": "explicitly_demote_BLACKBOX_to_VALIDATION_then_diagnostics_are_allowed_but_that_block_loses_independent_confirmation_status",
    "data_becomes_unusable_after_demotion": false
  },
  "sample_gate_policy": {
    "default_per_calendar_year_minimum": false,
    "preferred_basis": [
      "total_effective_TRAIN_sample",
      "total_effective_VALIDATION_sample",
      "at_least_two_chronological_subperiods_when_feasible",
      "predeclared_precision_or_minimum_detectable_effect",
      "year_level_results_as_stability_diagnostics_not_automatic_hard_gates"
    ],
    "historical_frozen_gates_are_rewritten": false,
    "T1_2019_48_lt_50_historical_decision_preserved": true
  },
  "R1_priority_retest": {
    "reason": "R1_is_unresolved_due_supply_not_rejected",
    "old_2015_2020_data_may_be_reused": true,
    "old_2015_2020_role": "TRAIN_plus_VALIDATION_not_fresh",
    "new_data_required_for_basic_research_execution": false,
    "new_data_preferred_for": [
      "increasing_event_supply",
      "testing_stability_across_new_market_regimes",
      "eventually_forming_a_small_blackbox_confirmation_reserve"
    ],
    "must_freeze_before_any_future_blackbox_confirmation": [

      "parent_representation": "mature_M0_L5_or_a_separately_accepted_new_M0_identity",
      "counter_shock_threshold": "0.5_times_parent_amplitude",
      "parameter_search_from_old_results": false
    }
  },
  "closed_lane_policy": {
    "R2_same_identity_reopen_without_new_theory": false,
    "R3_same_identity_reopen_without_new_theory": false,
    "R4_same_identity_reopen_without_new_theory": false,
    "T1_same_5sigma_960bar_historical_identity_retroactively_reopened": false,
    "new_identity_requires_preoutcome_definition": true
  },
  "cloud_actions_when_data_arrives": [
    "read_new_data_receipts_and_manifests",
    "write_cloud_source_admission_review",
    "append_admitted_rows_to_reusable_research_corpus_or_validation_pool",
    "do_not_immediately_burn_new_rows_as_blackbox",
    "when_a_candidate_is_mature_freeze_a_small_latest_blackbox_block_and_aggregate_only_output_contract",
    "execute_blackbox_only_after_candidate_freeze"
  ],
  "trading_PnL_authorized": false,
  "production_authority": false
}
